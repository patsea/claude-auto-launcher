#!/usr/bin/env bash
#
# claude-auto-boot-catchup
# Runs missed cron jobs after system boot
#
# Version: 1.0
# Created: 2026-01-18

set -euo pipefail

LOG_FILE="$HOME/.claude-auto/logs/boot-catchup.log"
LAST_RUN_FILE="$HOME/.claude-auto/.last-boot-catchup"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOG_FILE"
}

# Ensure log directory exists
mkdir -p "$HOME/.claude-auto/logs"

log "=========================================="
log "Boot Catch-Up Started"
log "=========================================="

# Get system boot time
BOOT_TIME=$(sysctl -n kern.boottime | awk '{print $4}' | sed 's/,//')
BOOT_DATE=$(date -r "$BOOT_TIME" '+%Y-%m-%d %H:%M:%S')
log "System booted at: $BOOT_DATE"

# Check if we've already run since this boot
if [ -f "$LAST_RUN_FILE" ]; then
    LAST_RUN=$(cat "$LAST_RUN_FILE")
    if [ "$LAST_RUN" -ge "$BOOT_TIME" ]; then
        log "Already ran since boot. Exiting."
        exit 0
    fi
fi

# Check if any jobs were missed: "today's slot has passed AND the job hasn't run today". Times are LOCAL.
#   audit   : 08:00 local (crontab 0 8 * * *); ran-today signal: its dated log
#   cleanup : 08:45 local; it has no ran-today signal of its own, so it keeps the gate it had when it was
#             coupled to the backup catch-up (Patrick 2026-06-01): the backup slot passed and the backup did
#             not run today.
# NOT here (option A, Patrick 21 Oct 2026): model-tasks and backup - the DevOps missed-slot reaper catches
# them up through the retry wrapper - and weekly-research, retired 10 Oct. Their calls pointed at paths that
# no longer exist; the foreground one exited 127 and, under set -e, ended the run before cleanup and the marker.
# 'readme' has no crontab entry (handled by LaunchAgent com.claude-auto.readme) - no catch-up gate.

HEARTBEAT_FILE="$HOME/Dropbox/ALOMA/claude-code/infra/state/claude-auto-heartbeats.json"
LOCAL_TODAY="$(date +%Y-%m-%d)"
LOCAL_MIDNIGHT_EPOCH="$(date -j -f '%Y-%m-%d %H:%M:%S' "${LOCAL_TODAY} 00:00:00" '+%s')"
NOW_EPOCH="${BOOT_CATCHUP_NOW:-$(date +%s)}"   # BOOT_CATCHUP_NOW: tests only

# Helper: did the named heartbeat job run since today's local midnight?
ran_today_heartbeat() {
    local key="$1" ep
    ep=$(jq -r ".\"${key}\".epoch // 0" "$HEARTBEAT_FILE" 2>/dev/null || echo 0)
    [ "$ep" -ge "$LOCAL_MIDNIGHT_EPOCH" ]
}

# Helper: has today's HH:MM local slot already passed?
slot_passed() {
    local hhmm="$1" slot_epoch
    slot_epoch=$(date -j -f '%Y-%m-%d %H:%M:%S' "${LOCAL_TODAY} ${hhmm}:00" '+%s')
    [ "$NOW_EPOCH" -ge "$slot_epoch" ]
}

MISSED_JOBS=()
if slot_passed '08:00' && [ ! -f "$HOME/.claude-auto/logs/audit-${LOCAL_TODAY}.log" ]; then
    MISSED_JOBS+=("audit")
fi
if slot_passed '08:45' && ! ran_today_heartbeat 'aloma-backup'; then
    MISSED_JOBS+=("cleanup")
fi

if [ ${#MISSED_JOBS[@]} -eq 0 ]; then
    log "No missed cron jobs. All scheduled tasks will run normally."
    echo "$BOOT_TIME" > "$LAST_RUN_FILE"
    exit 0
fi

log "Detected ${#MISSED_JOBS[@]} missed job(s): ${MISSED_JOBS[*]}"

# Each job on its own: a missing or failing target is logged with its exit code and never stops the
# next job or the marker.
run_job() {
    local name="$1"; shift
    local rc=0
    log "Running: $name"
    "$@" || rc=$?
    if [ "$rc" -eq 0 ]; then log "$name: ok (exit 0)"; else log "$name: FAILED (exit $rc)"; fi
}

for job in "${MISSED_JOBS[@]}"; do
    case "$job" in
        audit)   run_job audit   bash -c '"$HOME/.claude-auto/bin/claude-auto-audit" --no-color > "$HOME/.claude-auto/logs/audit-$(date +%Y-%m-%d).log" 2>&1' ;;
        cleanup) run_job cleanup bash -c '"$HOME/.claude-auto/bin/claude-auto-cleanup" >> "$HOME/.claude-auto/logs/boot-catchup.log" 2>&1' ;;
    esac
done

# Record this run, whatever the jobs did.
echo "$BOOT_TIME" > "$LAST_RUN_FILE"

log "=========================================="
log "Boot Catch-Up Complete"
log "=========================================="

exit 0
