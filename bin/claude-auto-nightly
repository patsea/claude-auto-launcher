#!/bin/bash
# claude-auto-nightly v3.0 - Nightly maintenance tasks
# Run via launchd at 2 AM or manually

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$SCRIPT_DIR/lib/config.sh"

LOG_FILE="${CLAUDE_AUTO_NIGHTLY_LOG:-/tmp/claude-auto-nightly-$(date +%Y-%m-%d).log}"
SUMMARY=""
HEARTBEAT_SCRIPT="${CLAUDE_AUTO_HEARTBEAT_SCRIPT:-/Users/pwilliamson/Dropbox/ALOMA/claude-code/infra/scripts/local-cron-heartbeat.sh}"
SLACK_DELIVERY_FAILED=0
START_TIME=$(date +%s)

log() {
    echo "[$(date '+%H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

add_summary() {
    SUMMARY="${SUMMARY}• $1\n"
}

convert_remotes_to_ssh() {
    log "=== Converting HTTPS remotes to SSH ==="
    local converted=0

    for repo in $CLAUDE_AUTO_REPOS; do
        if [[ -d "$CLAUDE_AUTO_WORKDIR/$repo/.git" ]]; then
            cd "$CLAUDE_AUTO_WORKDIR/$repo"
            remote_url=$(git remote get-url origin 2>/dev/null || echo "")

            if [[ "$remote_url" == https://github.com/* ]]; then
                ssh_url=$(echo "$remote_url" | sed 's|https://github.com/|git@github.com:|')
                git remote set-url origin "$ssh_url"
                log "  ✅ $repo: converted to SSH"
                ((converted++)) || true
            fi
        fi
    done

    [[ $converted -gt 0 ]] && add_summary "🔗 Converted $converted repos to SSH" || true
}

security_scan() {
    log "=== Security Scan ==="
    local issues=0

    for repo in $CLAUDE_AUTO_REPOS; do
        if [[ -d "$CLAUDE_AUTO_WORKDIR/$repo/.git" ]]; then
            cd "$CLAUDE_AUTO_WORKDIR/$repo"

            # Skip venv, node_modules, docs, examples
            matches=$(git diff --cached --diff-filter=ACMR -U0 2>/dev/null | \
                grep -iE "(api[_-]?key|password|secret|token|credential).*[=:]" | \
                grep -v "example\|placeholder\|your.*here\|venv\|node_modules" | \
                wc -l | tr -d ' ')

            if [[ $matches -gt 0 ]]; then
                log "  ⚠️  $repo: $matches potential secrets"
                ((issues++)) || true
            fi
        fi
    done

    if [[ $issues -gt 0 ]]; then
        add_summary "🔒 Security: $issues repos need review"
    else
        add_summary "🔒 Security: All repos clean"
    fi || true
}

auto_commit() {
    log "=== Auto-Commit ==="

    if [[ "${CLAUDE_AUTO_COMMIT_ENABLED:-false}" != "true" ]]; then
        log "  ⏭️  Auto-commit disabled"
        return
    fi

    local committed=0
    local skipped=0

    for repo in $CLAUDE_AUTO_REPOS; do
        if [[ -d "$CLAUDE_AUTO_WORKDIR/$repo/.git" ]]; then
            cd "$CLAUDE_AUTO_WORKDIR/$repo"

            changes=$(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')
            [[ $changes -eq 0 ]] && continue

            # Quick security check
            secrets=$(git diff --diff-filter=ACMR -U0 2>/dev/null | \
                grep -v "grep -.*E" | \
                grep -iE "(api[_-]?key|password|secret|token).*=" | \
                grep -v "example\|placeholder\|your.*here\|venv" | \
                wc -l | tr -d ' ')

            if [[ $secrets -gt 0 ]]; then
                log "  ⚠️  $repo: Skipped - potential secrets"
                ((skipped++)) || true
                continue
            fi

            file_count=$(git status --porcelain | wc -l | tr -d ' ')
            msg="${CLAUDE_AUTO_COMMIT_MESSAGE_PREFIX:-chore: auto-commit}: $file_count files $(date +%Y-%m-%d)"

            # Add all files respecting .gitignore
            git add -A

            # Remove instruction files from staging (even if accidentally added)
            git reset HEAD -- '*PHASE*.md' '*phase*.md' '*INSTRUCTION*.md' '*instruction*.md' \
                '*FIX*.md' '*fix*.md' '*UPDATE*.md' '*update*.md' '*RECON*.md' '*recon*.md' \
                '*PLAN*.md' '*plan*.md' '*BRIEFING*.md' '*briefing*.md' '*TEST_SCRIPT*.md' \
                '*test_script*.md' 'ALOMA*.md' 2>/dev/null || true

            # Verify no ALOMA references in staged files
            if git diff --cached | grep -qi "aloma"; then
                log "  ⚠️  $repo: Skipped - ALOMA reference detected in changes"
                git reset HEAD >/dev/null 2>&1
                ((skipped++)) || true
                continue
            fi

            if git commit -m "$msg" >/dev/null 2>&1; then
                if git push origin HEAD >/dev/null 2>&1; then
                    log "  ✅ $repo: Committed $file_count files"
                    ((committed++)) || true
                else
                    log "  ⚠️  $repo: Committed but push failed"
                fi
            else
                log "  ⏭️  $repo: Nothing to commit after staging"
            fi
        fi
    done

    [[ $committed -gt 0 ]] || [[ $skipped -gt 0 ]] && add_summary "📦 Auto-commit: $committed done, $skipped skipped" || true
}

discover_repos() {
    log "=== Repo Discovery ==="
    local new_repos=""

    [[ -z "${CLAUDE_AUTO_DISCOVERY_PATHS:-}" ]] && return

    local known_repos=" $CLAUDE_AUTO_REPOS "

    for scan_path in $CLAUDE_AUTO_DISCOVERY_PATHS; do
        scan_path=$(eval echo "$scan_path")
        [[ -d "$scan_path" ]] || continue

        while IFS= read -r -d '' git_dir; do
            repo_dir=$(dirname "$git_dir")
            repo_name=$(basename "$repo_dir")

            if [[ "$known_repos" != *" $repo_name "* ]]; then
                new_repos="$new_repos $repo_name"
                log "  🆕 Found: $repo_name"
            fi
        done < <(find "$scan_path" -maxdepth 2 -name ".git" -type d -print0 2>/dev/null)
    done

    [[ -n "$new_repos" ]] && add_summary "🔍 New repos:$new_repos" || true
}

cleanup_logs() {
    log "=== Log Cleanup ==="
    deleted=$(find /tmp -name "claude-auto-*.log" -mtime +7 -delete -print 2>/dev/null | wc -l | tr -d ' ')
    [[ $deleted -gt 0 ]] && log "  🗑️  Deleted $deleted old logs" || true
}

# The Slack webhook is a credential: it is read from the macOS Keychain, never from the config
# file (a CLAUDE_AUTO_SLACK_WEBHOOK line there is ignored).
# Webhook: Keychain service "oura-slack-webhook", account "aloma" = the #daily-job-updates incoming webhook.
# SHARED on purpose (Patrick, 26 Sep 2026) with the health-ingestion flow
# (~/Dropbox/Personal/Medical/_tools/oura_notify.py, LaunchAgent com.aloma.oura-ingest).
# Revoking, rotating or renaming that item breaks BOTH senders; update both together.
# CLAUDE_AUTO_SLACK_KEYCHAIN_SERVICE / _ACCOUNT (config or env) select a different item.
read_slack_webhook() {
    security find-generic-password -s "${CLAUDE_AUTO_SLACK_KEYCHAIN_SERVICE:-oura-slack-webhook}" \
        -a "${CLAUDE_AUTO_SLACK_KEYCHAIN_ACCOUNT:-aloma}" -w 2>/dev/null || true
}

# Delivered ONLY when Slack's reply is HTTP 200 with the body `ok`. A dead webhook answers
# HTTP 200 with `no_service`, so curl's exit code proves nothing (this used to log "sent" on the
# exit code alone). Anything else sets SLACK_DELIVERY_FAILED, which finish_run reports as a
# failed run. Never prints the webhook.
send_slack_summary() {
    if [[ "${CLAUDE_AUTO_SLACK_ENABLED:-true}" != "true" ]]; then
        log "  ⏭️  Slack summary disabled (CLAUDE_AUTO_SLACK_ENABLED)"
        return 0
    fi

    log "=== Sending Slack Summary ==="
    if [[ -n "${CLAUDE_AUTO_SLACK_WEBHOOK:-}" ]]; then
        log "  ⚠️  CLAUDE_AUTO_SLACK_WEBHOOK in the config file is ignored: the webhook is read from the Keychain"
    fi

    local webhook
    webhook=$(read_slack_webhook)
    if [[ -z "$webhook" ]]; then
        log "  ❌ Slack summary NOT delivered: webhook unreadable (Keychain service ${CLAUDE_AUTO_SLACK_KEYCHAIN_SERVICE:-oura-slack-webhook}, account ${CLAUDE_AUTO_SLACK_KEYCHAIN_ACCOUNT:-aloma})"
        SLACK_DELIVERY_FAILED=1
        return 1
    fi

    # Escape for JSON
    local escaped_summary=$(echo -e "$SUMMARY" | sed 's/"/\\"/g' | tr '\n' ' ')
    local header="🌙 Claude-Auto Nightly Report"
    # CLAUDE_AUTO_TEST_MARKER: a delivery test's marker text, prefixed to the header.
    [[ -n "${CLAUDE_AUTO_TEST_MARKER:-}" ]] && header="${CLAUDE_AUTO_TEST_MARKER} ${header}"

    local payload=$(cat <<EOF
{
    "blocks": [
        {
            "type": "header",
            "text": {
                "type": "plain_text",
                "text": "${header}",
                "emoji": true
            }
        },
        {
            "type": "section",
            "text": {
                "type": "mrkdwn",
                "text": "*$(date '+%A, %B %d, %Y')*\n\n$escaped_summary"
            }
        }
    ]
}
EOF
)

    local errf resp http rc=0 err
    errf=$(mktemp "${TMPDIR:-/tmp}/claude-auto-slack.XXXXXX")
    resp=$(curl -sS -m 20 -w $'\n%{http_code}' -X POST -H 'Content-type: application/json' \
        --data "$payload" "$webhook" 2>"$errf") || rc=$?
    http="${resp##*$'\n'}"
    resp="${resp%$'\n'*}"
    err=$(head -c 200 "$errf" | tr '\n' ' ')
    rm -f "$errf"

    if [[ $rc -ne 0 ]]; then
        log "  ❌ Slack summary NOT delivered: curl exit $rc (${err//"$webhook"/<webhook>})"
        SLACK_DELIVERY_FAILED=1
        return 1
    fi
    if [[ "$http" != "200" || "$resp" != "ok" ]]; then
        local snip="${resp:0:120}"
        log "  ❌ Slack summary NOT delivered: HTTP $http, body '${snip:-EMPTY}' (Slack answers 'ok' only on delivery)"
        SLACK_DELIVERY_FAILED=1
        return 1
    fi
    log "  ✅ Slack summary delivered (HTTP 200, body: ok)"
    return 0
}

# Heartbeat and exit status. A summary that was not delivered is a FAILED run: the heartbeat says
# failure, so the monitoring that reads it reports this job somewhere other than the channel that
# just failed, and the script exits 2.
finish_run() {
    local status=success rc=0
    if [[ "$SLACK_DELIVERY_FAILED" -eq 1 ]]; then
        status=failure
        rc=2
    fi
    DURATION=$(($(date +%s) - START_TIME))
    if [[ -x "$HEARTBEAT_SCRIPT" ]]; then
        "$HEARTBEAT_SCRIPT" "claude-auto-nightly" "$status" "$DURATION"
        log "Heartbeat recorded: $status (duration: ${DURATION}s)"
    fi
    return $rc
}

main() {
    echo "" > "$LOG_FILE"
    log "╔══════════════════════════════════════════════════════════════╗"
    log "║  claude-auto-nightly v3.0                                    ║"
    log "╚══════════════════════════════════════════════════════════════╝"

    load_config

    convert_remotes_to_ssh
    security_scan
    auto_commit
    discover_repos
    cleanup_logs

    # Cleanup old instruction files
    if [[ -x "$SCRIPT_DIR/lib/cleanup-instruction-files.sh" ]]; then
        "$SCRIPT_DIR/lib/cleanup-instruction-files.sh"
        INSTRUCTION_CLEANUP=$(cat /tmp/instruction-cleanup-count.txt 2>/dev/null || echo "0")
        [[ $INSTRUCTION_CLEANUP -gt 0 ]] && add_summary "🧹 Instruction files cleaned: $INSTRUCTION_CLEANUP" || true
    fi

    send_slack_summary

    log ""
    log "=== Complete ==="

    echo ""
    echo "Log: $LOG_FILE"

    finish_run
}

# Run only when executed, so tests can source this file and call its functions.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
    exit $?
fi
